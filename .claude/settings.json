{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session-start-register.ps1\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$j = $input | Out-String | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -match 'backend[/\\\\]src[/\\\\]main[/\\\\]java.*\\.java') { Set-Location 'C:/AIDA/OMILORE'; docker compose build lore-backend 2>&1 | Write-Output; docker compose up -d lore-backend 2>&1 | Write-Output }",
            "timeout": 180,
            "statusMessage": "Rebuilding lore-backend Docker image...",
            "async": true
          }
        ]
      }
    ]
  }
}
