# LORE Installer — файл доступа (КЛЮЧ=значение). Значения учёток нигде не печатаются.
# Источник (база, с которой переносим) — только читается.
MIG_DB_URL=http://127.0.0.1:2480
MIG_SRC_DB=
MIG_SRC_USER=
MIG_SRC_PASSWORD=
# Приёмник — новая база; не может совпадать с источником и не может быть рабочей.
MIG_DST_DB=
MIG_DST_USER=
MIG_DST_PASSWORD=
# Необязательно: сервер приёмника, если он другой.
MIG_DST_URL=
# Вход владельца через Keycloak (шаг 0).
MIG_KC_URL=
MIG_KC_REALM=
MIG_KC_CLIENT=lore-app
MIG_OWNER_PROJECT=
