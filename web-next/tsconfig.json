{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    // K5-PACKAGE-DELIVERY: kit — пакет @seidr/kit из реестра (AIDA/lorekit), типы из его dist.
    // Условия «seidr-source» здесь нет: оно ведёт в исходники, которых в пакете нет.
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
    // paths на ./node_modules для peer-ов kit больше не нужны: они были для исходников ../kit,
    // от которых tsc искал типы вверх по дереву. Пакет лежит в web-next/node_modules и
    // разрешает peer-ы оттуда же.
  },
  "include": ["src", "vite.config.ts"]
}
