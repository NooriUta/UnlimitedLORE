{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Исходники kit (../kit) тянут `react`: без этого tsc ищет типы вверх от
    // kit/ и в образе (где kit/node_modules нет) их не находит, а локально
    // молча берёт чужую копию из корня репо. Проверено --traceResolution (S4-00a).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      // То же для @iconify/react — peer kit с S4-00b (GameIcon).
      "@iconify/react/offline": ["./node_modules/@iconify/react/dist/offline.d.ts"],
      // То же для peer-ов @seidr/kit/content (S4-00d): TipTap, mermaid, bpmn-js…
      "@tiptap/*": ["./node_modules/@tiptap/*"],
      "tiptap-markdown": ["./node_modules/tiptap-markdown"],
      "marked": ["./node_modules/marked"],
      "katex": ["./node_modules/katex"],
      "mermaid": ["./node_modules/mermaid"],
      "@mermaid-js/layout-elk": ["./node_modules/@mermaid-js/layout-elk"],
      "bpmn-js/*": ["./node_modules/bpmn-js/*"],
      "dompurify": ["./node_modules/dompurify"],
      // Вход kit (@seidr/kit/auth, S3-18) — тот же случай: peer oidc-client-ts.
      "oidc-client-ts": ["./node_modules/oidc-client-ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
