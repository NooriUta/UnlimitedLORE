{
  "format": "forgejo-read-probes/1",
  "about": "SPRINT_FORGEJO_MINIAPP/FJ-04: QG-прогон read-группы миниаппа против нашего Forgejo. Каждый read-маршрут вызывается с контрольными args; {\"$ref\": route, \"at\": путь} берёт значение из ответа уже выполненной пробы (номер, id, sha). expect: found — должны быть данные (позитивный контроль: пусто ≠ проверили), found_or_empty — достаточно, что вызов выполнен, refused — маршрут намеренно не исполняется (capability не подключена), с причиной. check — поле ответа, которое обязано совпасть. Новый read-маршрут без пробы краснит ForgejoReadProbesTest.",
  "probes": [
    { "route": "get_server_version", "expect": "found" },
    { "route": "get_nodeinfo", "expect": "found" },
    { "route": "get_authenticated_user", "expect": "found" },
    { "route": "get_user", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found" },
    { "route": "list_user_orgs", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found_or_empty" },
    { "route": "list_user_repos", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found_or_empty" },
    { "route": "list_user_starred", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found_or_empty" },
    { "route": "list_followers", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found_or_empty" },
    { "route": "list_following", "args": { "username": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found_or_empty" },
    { "route": "search_users", "args": { "q": { "$ref": "get_authenticated_user", "at": "login" } }, "expect": "found" },
    { "route": "list_my_starred", "expect": "found_or_empty" },
    { "route": "list_my_notifications", "expect": "found_or_empty" },

    { "route": "list_orgs", "expect": "found" },
    { "route": "get_org", "args": { "org": "AIDA" }, "expect": "found", "check": { "field": "username", "eq": "AIDA" } },
    { "route": "list_org_repos", "args": { "org": "AIDA" }, "expect": "found" },
    { "route": "list_org_members", "args": { "org": "AIDA" }, "expect": "found_or_empty" },
    { "route": "list_org_teams", "args": { "org": "AIDA" }, "expect": "found_or_empty" },
    { "route": "get_team", "args": { "id": { "$ref": "list_org_teams", "at": "0.id" } }, "expect": "found" },
    { "route": "list_org_labels", "args": { "org": "AIDA" }, "expect": "found_or_empty" },

    { "route": "search_repos", "args": { "q": "UnlimitedLORE" }, "expect": "found" },
    { "route": "get_repo", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found", "check": { "field": "full_name", "eq": "AIDA/UnlimitedLORE" } },
    { "route": "list_forks", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found_or_empty" },
    { "route": "list_collaborators", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found_or_empty" },
    { "route": "list_repo_topics", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found_or_empty" },
    { "route": "list_branches", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found" },
    { "route": "get_branch", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "branch": "develop" }, "expect": "found", "check": { "field": "name", "eq": "develop" } },
    { "route": "list_repo_commits", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "limit": 3 }, "expect": "found" },
    { "route": "get_commit_status", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "sha": { "$ref": "list_repo_commits", "at": "0.sha" } }, "expect": "found" },
    { "route": "get_file_contents", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "filepath": "backend/build.gradle" }, "expect": "found" },
    { "route": "list_tags", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found" },
    { "route": "list_releases", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "limit": 5 }, "expect": "found" },
    { "route": "list_release_assets", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "id": { "$ref": "list_releases", "at": "0.id" } }, "expect": "found_or_empty" },
    { "route": "get_release_asset", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "id": { "$ref": "list_releases", "at": "0.id" }, "attachment_id": { "$ref": "list_release_assets", "at": "0.id" } }, "expect": "found" },

    { "route": "list_pull_requests", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "state": "all", "limit": 5 }, "expect": "found" },
    { "route": "get_pull_request", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": 1827 }, "expect": "found", "check": { "field": "number", "eq": 1827 } },
    { "route": "list_pr_files", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": 1827 }, "expect": "found" },
    { "route": "list_pr_commits", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": 1827 }, "expect": "found" },
    { "route": "get_pr_diff", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": 1837 }, "expect": "found" },
    { "route": "list_pr_reviews", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": 1827 }, "expect": "found_or_empty" },

    { "route": "list_issues", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "state": "all", "limit": 5 }, "expect": "found_or_empty" },
    { "route": "get_issue", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": { "$ref": "list_issues", "at": "0.number" } }, "expect": "found" },
    { "route": "list_issue_comments", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "index": { "$ref": "list_issues", "at": "0.number" } }, "expect": "found_or_empty" },
    { "route": "list_labels", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found_or_empty" },
    { "route": "get_label", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "id": { "$ref": "list_labels", "at": "0.id" } }, "expect": "found" },
    { "route": "list_milestones", "args": { "owner": "AIDA", "repo": "UnlimitedLORE" }, "expect": "found_or_empty" },
    { "route": "get_milestone", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "id": { "$ref": "list_milestones", "at": "0.id" } }, "expect": "found" },

    { "route": "list_workflow_runs", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "limit": 3 }, "expect": "found" },
    { "route": "get_job_log", "args": { "owner": "AIDA", "repo": "UnlimitedLORE", "task_id": 1 }, "expect": "refused", "reason": "OQ-060-LOGS-VOLUME: журналы — не REST (том .log.zst / dbfs), способ доступа — SPRINT_FORGEJO_MINIAPP/FJ-08" },

    { "route": "list_gitignore_templates", "expect": "found" },
    { "route": "get_gitignore_template", "args": { "name": { "$ref": "list_gitignore_templates", "at": "0" } }, "expect": "found" },
    { "route": "list_license_templates", "expect": "found" },
    { "route": "get_license_template", "args": { "name": { "$ref": "list_license_templates", "at": "0.key" } }, "expect": "found" },
    { "route": "list_label_templates", "expect": "found" },
    { "route": "get_label_template", "args": { "name": { "$ref": "list_label_templates", "at": "0" } }, "expect": "found" },
    { "route": "render_markdown", "args": { "text": "**ok**" }, "expect": "found" },
    { "route": "render_markup", "args": { "text": "**ok**" }, "expect": "found" }
  ]
}
